# HoldHarmless — environment template
# Copy to .env and fill in the values. .env is gitignored and must never be committed (§14 pre-flight).

# ---------------------------------------------------------------------------
# REQUIRED — Day 0 onwards
# ---------------------------------------------------------------------------

# AssemblyAI API key. Get it from https://www.assemblyai.com/app/api-keys
# Sent as an HTTP header on the WebSocket upgrade:  Authorization: Bearer <key>
# Format: 32 lowercase hex characters, e.g. 0a1b2c3d4e5f60718293a4b5c6d7e8f9
ASSEMBLYAI_API_KEY=

# Voice Agent API WebSocket endpoint. Confirmed in the public docs; E0 re-confirms
# it for this account and the result is written back to SSOT §7.1.
ASSEMBLYAI_WS_URL=wss://agents.assemblyai.com/v1/ws

# Agent voice. IMMUTABLE after session.ready and case-sensitive lowercase (§7.1).
# English voices: alba eve george jane jean mary michael  (US accent)
#                 anna charles paul vera                  (UK accent)
ASSEMBLYAI_VOICE=michael

# ---------------------------------------------------------------------------
# SET BY DAY-0 / WEEK-1 EXPERIMENTS — leave as-is until the experiment reports
# ---------------------------------------------------------------------------

# Set to true only once E0 observes session.updated for interruption_delay (ADR-011, A-18).
ENABLE_INTERRUPTION_DELAY=false

# Audio encoding for input.format / output.format. SSOT assumes audio/pcmu at 8000 Hz.
# E2 confirms it; if it fails, fall back to the 24 kHz path behind this flag (§13).
AUDIO_ENCODING=audio/pcmu
AUDIO_SAMPLE_RATE=8000

# dtmf | speech — set by E1 in week 1 (ADR-013, §13).
IVR_NAV_MODE=dtmf

# ---------------------------------------------------------------------------
# MONOREPO RUNTIME — not used by the Day-0 scaffold (§13)
# ---------------------------------------------------------------------------

NETWORK_PROFILE=TELEPHONY
HARNESS_WS_URL=ws://127.0.0.1:8081/call
HARNESS_CONTROL_URL=ws://127.0.0.1:8081/control
IVR_DIFFICULTY=REALISTIC
DEMO_MODE=false
REDACT_TRANSCRIPT=false
