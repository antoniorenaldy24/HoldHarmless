{
  "name": "holdharmless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "check:invariants": "tsx scripts/check-invariants.ts",
    "check:doc": "tsx scripts/check-doc-claims.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:invariants && pnpm check:doc"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@holdharmless/invariants": "workspace:*"
  }
}
